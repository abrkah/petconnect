# PetConnect API (NestJS default port in main.ts)
# Local run: copy to backend/pet-care-app/.env
# Docker: use repo root .env (see /README.md) — DATABASE_HOST is set to `db` in compose.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=petconnect
DATABASE_PASSWORD=petconnect
DATABASE_NAME=petcare

JWT_SECRET=change-me-in-production
JWT_EXPIRE_IN=86400

# Optional: Gmail SMTP for signup emails
# EMAIL_USER=
# EMAIL_PASS=

# Optional: Google OAuth (omit on Render/Vercel — email login still works)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
