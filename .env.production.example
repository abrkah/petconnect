# === Neon (free Postgres) — https://neon.tech
# Create a project, copy the connection string (pooled or direct).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/petcare?sslmode=require

# === Render API (after deploy) — https://render.com
# PORT is set by Render (often 10000); do not hardcode on Render.
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_IN=86400
FRONTEND_URL=https://your-app.vercel.app

# === Vercel frontend — set in Vercel project Environment Variables
# NEXT_PUBLIC_API_URL=https://petconnect-api.onrender.com
